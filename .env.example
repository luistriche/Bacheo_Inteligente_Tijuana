# Copia este archivo a .env y rellena con tus credenciales reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
#
# Gemini (Google AI Studio -> Get API key). Copia aqui tu llave real.
GEMINI_API_KEY=TU_LLAVE_DE_GEMINI_AQUI

# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklmnoPQRstuvwxyz

# Secreto para validar que los webhooks vienen de Telegram (inventa uno largo)
TELEGRAM_SECRET=un_secreto_largo_y_aleatorio
