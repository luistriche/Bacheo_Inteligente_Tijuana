[node name="Desc" type="Label" parent="Views/ViewEstadisticas/HBox/PanelZonaA/VBox"]
margin_top = 22.0
margin_right = 418.0
margin_bottom = 400.0
size_flags_vertical = 3
text = "• Ubicación: Avenida Paseo Ensenada (Playas de Tijuana)
• Volumen: 2,000 reportes ciudadanos (6 meses)
• Tipo de Deterioro: Superficial estable (baches de 3 a 5 cm)
• Aforo Pesado: 10% (vehículos locales y particulares)
• Riesgo de Socavón: 2% (Subsuelo consolidado y seco)
• IPU Promedio Calculado: 22.6 / 100
• Presión Social: Alta (amenaza de bloqueos vecinales)
• Costo de Reparación: $3,500 MXN por bache

DIAGNÓSTICO DEL CIENTÍFICO DE DATOS:
Atender esta zona por 'orden de llegada' satisface la presión política inmediata pero desperdicia el presupuesto de emergencia en daños estables que no amenazan la vida ni la economía."
autowrap = true

